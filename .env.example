# ============================================
# BASEROW CONFIGURATION
# ============================================
# Get these from Baserow → Settings → API tokens & Database settings
# 
# 1. Sign up at https://baserow.io (free tier: 1000 rows)
# 2. Create a new database "INVERTA Onboarding"
# 3. Create a table with all the required fields (see README.md)
# 4. Settings → API tokens → Create token (Read + Create)
# 5. Click table → Get table ID from URL (number after /table/)

BASEROW_URL=https://crm.invertadigital.de
BASEROW_TOKEN=your_baserow_token_here
BASEROW_TABLE_ID=12345
